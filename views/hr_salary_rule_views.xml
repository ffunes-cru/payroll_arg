<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_salary_rule_form_payroll_arg" model="ir.ui.view">
        <field name="name">hr.salary.rule.form.payroll.arg</field>
        <field name="model">hr.salary.rule</field>
        <field name="inherit_id" ref="payroll.hr_salary_rule_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='principal']" position="after">
                <group string="Clasificación AFIP / ARCA (Libro de Sueldos Digital)">
                    <group>
                        <field name="tipo_concepto"/>
                        <field name="afip_code"/>
                        <field name="afip_unit"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
