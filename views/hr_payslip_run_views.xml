<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_payslip_run_form_payroll_arg" model="ir.ui.view">
        <field name="name">hr.payslip.run.form.payroll.arg</field>
        <field name="model">hr.payslip.run</field>
        <field name="inherit_id" ref="payroll.hr_payslip_run_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='close_payslip_run']" position="attributes">
                <attribute name="string">Cerrar Lote</attribute>
                <attribute name="confirm">¿Está seguro de cerrar el lote? Todos los recibos en borrador y en espera serán confirmados automáticamente.</attribute>
            </xpath>
            <xpath expr="//button[@name='%(payroll.action_hr_payslip_by_employees)d']" position="attributes">
                <attribute name="string">Generar Recibos</attribute>
            </xpath>
            <xpath expr="//button[@name='draft_payslip_run']" position="attributes">
                <attribute name="string">Volver a Borrador</attribute>
            </xpath>
            <xpath expr="//header" position="inside">
                <button
                    name="action_compute_payslips"
                    type="object"
                    string="Recalcular Recibos"
                    class="oe_highlight btn-primary"
                    invisible="state != 'draft'"
                />
                <button
                    name="action_reload_period_inputs"
                    type="object"
                    string="Recargar Novedades del Período"
                    invisible="state != 'draft'"
                    confirm="Se vuelven a leer calendario, licencias, asistencias y ficha del empleado, pisando horas, vacaciones, feriados, SIRADIG y aporte adicional en todos los recibos (salvo los códigos fijados en Valores del Lote). ¿Continuar?"
                />
                <button
                    name="action_open_input_import"
                    type="object"
                    string="Importar Novedades (CSV)"
                    invisible="state != 'draft'"
                />
                <button
                    name="action_open_export_wizard"
                    type="object"
                    string="Exportar Reportes Argentina (PDF / AFIP / Banco)"
                    class="oe_highlight btn-info"
                />
            </xpath>
            <xpath expr="//field[@name='struct_id']" position="replace"/>
            <xpath expr="//group[@name='period_group']" position="after">
                <group string="Parámetros de Liquidación AFIP / ARCA">
                    <field name="tipo_liquidacion" readonly="state != 'draft'"/>
                    <field name="afip_nro_liquidacion" readonly="state != 'draft'"/>
                    <field name="payment_date" readonly="state != 'draft'"/>
                    <field name="struct_id" string="Estructura Salarial (Opcional)" options="{'no_create': True}"
                           placeholder="Automática según tipo de liquidación y contrato" readonly="state != 'draft'"/>
                    <field name="coef_contrib_ss" readonly="state != 'draft'"/>
                    <field name="coef_contrib_os" readonly="state != 'draft'"/>
                </group>
            </xpath>
            <xpath expr="//field[@name='slip_ids']/preceding-sibling::separator[1]" position="replace"/>
            <xpath expr="//field[@name='slip_ids']" position="replace">
                <notebook>
                    <page name="novedades" string="Novedades">
                        <separator string="Valores del Lote"/>
                        <field name="novelty_ids" readonly="state != 'draft'" nolabel="1">
                            <list editable="bottom">
                                <field name="input_id" options="{'no_create': True}"/>
                                <field name="code" optional="hide"/>
                                <field name="amount"/>
                                <button name="action_apply" type="object" string="Aplicar a todos"
                                        icon="fa-arrow-down" class="btn-link"
                                        confirm="Se pisa este código en todos los recibos editables del lote. ¿Continuar?"/>
                            </list>
                        </field>
                        <separator string="Horas, Días y Cantidades por Empleado"/>
                        <field name="input_qty_line_ids" widget="x2many_2d_matrix"
                               field_x_axis="code" field_y_axis="employee_id" field_value="amount"
                               show_row_totals="0"
                               readonly="state != 'draft'" nolabel="1">
                            <list>
                                <field name="code"/>
                                <field name="employee_id"/>
                                <field name="amount" readonly="payslip_state not in ('draft', 'verify')"/>
                                <field name="payslip_state" column_invisible="1"/>
                            </list>
                        </field>
                        <separator string="Importes por Empleado ($)"/>
                        <field name="input_amount_line_ids" widget="x2many_2d_matrix"
                               field_x_axis="code" field_y_axis="employee_id" field_value="amount"
                               show_row_totals="0"
                               readonly="state != 'draft'" nolabel="1">
                            <list>
                                <field name="code"/>
                                <field name="employee_id"/>
                                <field name="amount" readonly="payslip_state not in ('draft', 'verify')"/>
                                <field name="payslip_state" column_invisible="1"/>
                            </list>
                        </field>
                    </page>
                    <page name="recibos" string="Recibos">
                        <field name="slip_ids" readonly="state == 'close'"
                               context="{'default_payslip_run_id': id, 'default_date_from': date_start, 'default_date_to': date_end}">
                            <list decoration-muted="state == 'cancel'" create="0">
                                <field name="number" decoration-bf="1" optional="show"/>
                                <field name="employee_id"/>
                                <field name="name" optional="hide"/>
                                <field name="struct_id" optional="hide"/>
                                <field name="antiguedad_anios" optional="show" string="Antig."/>
                                <field name="total_remunerativo" optional="show" widget="monetary"/>
                                <field name="total_no_remunerativo" optional="hide" widget="monetary"/>
                                <field name="total_retenciones" optional="hide" widget="monetary"/>
                                <field name="neto_liquidacion" optional="show" widget="monetary" decoration-bf="1" decoration-success="1"/>
                                <field name="state" widget="badge" decoration-success="state == 'done'" decoration-warning="state == 'verify'" decoration-info="state == 'draft'" decoration-danger="state == 'cancel'"/>
                                <button name="action_open_payslip" type="object" icon="fa-external-link" title="Abrir Recibo Completo"/>
                            </list>
                        </field>
                    </page>
                </notebook>
            </xpath>
        </field>
    </record>
</odoo>
