<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- VISTA LISTA / TREE DE PRESENTACIONES F.572 -->
    <record id="view_hr_siradig_f572_tree" model="ir.ui.view">
        <field name="name">hr.siradig.f572.tree</field>
        <field name="model">hr.siradig.f572</field>
        <field name="arch" type="xml">
            <list string="Declaraciones Juradas SIRADIG F.572" default_order="periodo_fiscal desc, fecha_presentacion desc">
                <field name="periodo_fiscal" string="Año"/>
                <field name="employee_id"/>
                <field name="cuit_empleado"/>
                <field name="nro_presentacion" string="Envío #"/>
                <field name="fecha_presentacion"/>
                <field name="cargas_resumen"/>
                <field name="total_deducciones_anual" widget="monetary" sum="Total Anual"/>
                <field name="deduccion_mensual_estimada" widget="monetary" sum="Total Mensual"/>
                <field name="state" widget="badge" decoration-success="state == 'applied'" decoration-warning="state == 'draft'"/>
            </list>
        </field>
    </record>

    <!-- VISTA FORMULARIO DETALLADA F.572 -->
    <record id="view_hr_siradig_f572_form" model="ir.ui.view">
        <field name="name">hr.siradig.f572.form</field>
        <field name="model">hr.siradig.f572</field>
        <field name="arch" type="xml">
            <form string="Declaración Jurada SIRADIG F.572 Web (AFIP / ARCA)">
                <header>
                    <button
                        name="action_apply_to_employee"
                        type="object"
                        string="⚡ Aplicar a la Ficha del Empleado"
                        class="btn-primary"
                        invisible="state == 'applied'"
                        help="Copia las cargas de familia y el promedio mensual de deducciones a la ficha del empleado para que impacten en las liquidaciones."
                    />
                    <button
                        name="action_apply_to_employee"
                        type="object"
                        string="🔄 Re-Aplicar a la Ficha"
                        class="btn-outline-secondary"
                        invisible="state != 'applied'"
                        help="Vuelve a volcar los datos a la ficha del empleado si se cambiaron manualmente."
                    />
                    <field name="state" widget="statusbar" statusbar_visible="draft,applied"/>
                </header>
                <sheet>
                    <div class="alert alert-info" role="status">
                        <strong>📌 Declaración Jurada F.572 Web del Empleado:</strong>
                        Esta presentación contiene las deducciones personales y cargas de familia que el trabajador declaró ante la AFIP/ARCA para el año fiscal <b><field name="periodo_fiscal" readonly="1"/></b>. 
                        Presione <b>⚡ Aplicar a la Ficha del Empleado</b> para que el cálculo acumulativo del Impuesto a las Ganancias 4ta Categoría compute estas deducciones automáticamente.
                    </div>
                    <div class="oe_title">
                        <label for="display_name" string="Presentación SIRADIG"/>
                        <h1>
                            <field name="display_name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Datos del Empleado y Presentación">
                            <field name="employee_id"/>
                            <field name="cuit_empleado"/>
                            <field name="periodo_fiscal"/>
                            <field name="nro_presentacion"/>
                        </group>
                        <group string="Fechas y Auditoría">
                            <field name="fecha_presentacion"/>
                            <field name="date_applied" invisible="not date_applied"/>
                            <field name="xml_filename" readonly="1"/>
                            <field name="company_id" invisible="1"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>

                    <group string="Resumen de Importes Computables en Ganancias">
                        <group>
                            <field name="cargas_resumen" readonly="1" style="font-weight: bold;"/>
                            <field name="tiene_conyuge" readonly="1"/>
                            <field name="cant_hijos" readonly="1"/>
                            <field name="cant_hijos_incapacitados" readonly="1"/>
                        </group>
                        <group>
                            <field name="total_deducciones_anual" widget="monetary" readonly="1" style="font-weight: bold;"/>
                            <field name="deduccion_mensual_estimada" widget="monetary" readonly="1" style="font-size: 1.25em; font-weight: bold; color: #007bff;"/>
                            <field name="total_pagos_cuenta" widget="monetary" readonly="1"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="👨‍👩‍👧‍👦 Cargas de Familia (Hijos y Cónyuge)" name="cargas_familia">
                            <div class="text-muted mb-2">
                                ℹ️ <b>Art. 30 inc. b de la Ley de Ganancias y RG 4003:</b> Se deduce cónyuge/conviviente y cada hijo menor de 18 años (o con discapacidad sin límite de edad). Si el hijo es declarado al 50%, la deducción se comparte legalmente con el otro progenitor.
                            </div>
                            <field name="cargas_familia_ids">
                                <list editable="bottom">
                                    <field name="parentesco"/>
                                    <field name="nombre_completo"/>
                                    <field name="nro_doc"/>
                                    <field name="mes_desde"/>
                                    <field name="mes_hasta"/>
                                    <field name="porcentaje_deduccion" widget="percentage"/>
                                </list>
                            </field>
                        </page>

                        <page string="💳 Deducciones Generales (Alquiler, Prepagas, etc.)" name="deducciones">
                            <div class="text-muted mb-2">
                                ℹ️ <b>Gastos declarados en F.572 Web:</b> Prepagas, seguros, alquiler de casa habitación, servicio doméstico, intereses hipotecarios, gastos de educación, etc.
                            </div>
                            <field name="deduccion_ids">
                                <list editable="bottom">
                                    <field name="tipo_nombre"/>
                                    <field name="descripcion"/>
                                    <field name="cuit_prestador"/>
                                    <field name="monto_total" widget="monetary" sum="Total"/>
                                    <field name="monto_mensual_estimado" widget="monetary" sum="Total Mensual"/>
                                    <field name="tope_legal_info" style="font-style: italic; color: #6c757d;"/>
                                </list>
                            </field>
                        </page>

                        <page string="🏛️ Pagos a Cuenta / Percepciones" name="pagos_cuenta">
                            <div class="text-muted mb-2">
                                ℹ️ Percepciones por compra de moneda extranjera, compras con tarjeta en el exterior, aduana, etc.
                            </div>
                            <field name="pago_cuenta_ids">
                                <list editable="bottom">
                                    <field name="tipo"/>
                                    <field name="descripcion"/>
                                    <field name="monto_total" widget="monetary" sum="Total Percepciones"/>
                                </list>
                            </field>
                        </page>

                        <page string="💼 Pluriempleo (Otros Empleadores)" name="pluriempleo" invisible="not otro_empleador_ids">
                            <div class="text-muted mb-2">
                                ℹ️ Sueldos brutos y aportes correspondientes a otros trabajos simultáneos informados por el empleado.
                            </div>
                            <field name="otro_empleador_ids">
                                <list editable="bottom">
                                    <field name="cuit"/>
                                    <field name="razon_social"/>
                                    <field name="mes"/>
                                    <field name="ganancia_bruta" widget="monetary"/>
                                    <field name="retenciones_ley" widget="monetary"/>
                                    <field name="retencion_ganancias" widget="monetary"/>
                                </list>
                            </field>
                        </page>

                        <page string="📄 XML Original (Auditoría AFIP)" name="xml_raw">
                            <field name="xml_raw_content" readonly="1" widget="text" style="font-family: monospace; font-size: 0.85em;"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- BÚSQUEDA Y FILTROS -->
    <record id="view_hr_siradig_f572_search" model="ir.ui.view">
        <field name="name">hr.siradig.f572.search</field>
        <field name="model">hr.siradig.f572</field>
        <field name="arch" type="xml">
            <search string="Buscar Presentaciones SIRADIG F.572">
                <field name="employee_id"/>
                <field name="cuit_empleado"/>
                <field name="periodo_fiscal"/>
                <filter string="Sin Aplicar" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Aplicadas" name="applied" domain="[('state', '=', 'applied')]"/>
                <group>
                    <filter string="Empleado" name="group_employee" context="{'group_by': 'employee_id'}"/>
                    <filter string="Año Fiscal" name="group_periodo" context="{'group_by': 'periodo_fiscal'}"/>
                    <filter string="Estado" name="group_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ACCIÓN DE VENTANA -->
    <record id="action_hr_siradig_f572" model="ir.actions.act_window">
        <field name="name">Declaraciones SIRADIG F.572</field>
        <field name="res_model">hr.siradig.f572</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_hr_siradig_f572_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No hay declaraciones SIRADIG F.572 registradas aún.
            </p>
            <p>
                Puede importar los archivos XML o ZIP descargados del servicio "SIRADIG - Empleador" de AFIP
                utilizando el botón <b>Importar SIRADIG AFIP</b> en el menú de Nómina Argentina.
            </p>
        </field>
    </record>
</odoo>
