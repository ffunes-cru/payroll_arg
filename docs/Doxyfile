# Configuración de Doxygen. Uso, desde addons/payroll_arg: doxygen docs/Doxyfile → docs/api/html/index.html
PROJECT_NAME           = "Nómina Argentina"
PROJECT_BRIEF          = "Módulo de Odoo 19: liquidación de jornalizados UOM y mensualizados, ARCA (LSD, F.931) y Ganancias"
OUTPUT_DIRECTORY       = docs/api
OUTPUT_LANGUAGE        = Spanish
CREATE_SUBDIRS         = NO
INPUT                  = README.md docs __init__.py models wizard tools migrations tests ../payroll_arg_attendance
FILE_PATTERNS          = *.py *.md
RECURSIVE              = YES
EXCLUDE                = docs/api payroll_arg_reportes
EXCLUDE_PATTERNS       = */__pycache__/*
USE_MDFILE_AS_MAINPAGE = README.md
MARKDOWN_SUPPORT       = YES
TOC_INCLUDE_HEADINGS   = 3
PYTHON_DOCSTRING       = NO
JAVADOC_AUTOBRIEF      = YES
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = YES
EXTRACT_STATIC         = YES
HIDE_SCOPE_NAMES       = NO
SORT_MEMBER_DOCS       = NO
SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES
GENERATE_BUGLIST       = YES
GENERATE_TODOLIST      = YES
ALIASES                = "returns=@return"
QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_NO_PARAMDOC       = NO
WARN_IF_DOC_ERROR      = YES
GENERATE_HTML          = YES
GENERATE_LATEX         = NO
GENERATE_TREEVIEW      = YES
SEARCHENGINE           = YES
HAVE_DOT               = NO
MERMAID_RENDER_MODE    = CLIENT_SIDE
