    <record id="rule_payslip_input_officer" model="ir.rule">
        <field name="name">Novedades: oficial de nómina y subordinados</field>
        <field name="model_id" ref="payroll.model_hr_payslip_input"/>
        <field name="domain_force">['|', '|', ('payslip_id.employee_id.user_id', '=', user.id), ('payslip_id.employee_id.department_id', '=', False), ('payslip_id.employee_id.department_id.manager_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('payroll.group_payroll_user'))]"/>
    </record>
