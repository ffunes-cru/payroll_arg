<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_siradig_import_wizard_form" model="ir.ui.view">
        <field name="name">hr.siradig.import.wizard.form</field>
        <field name="model">hr.siradig.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Importar Deducciones SIRADIG F.572 (AFIP / ARCA)">
                <sheet>
                    <div class="alert alert-info" role="status" invisible="state != 'choose'">
                        <h5 class="alert-heading font-weight-bold">📥 ¿Cómo descargar e importar el SIRADIG F.572 de AFIP?</h5>
                        <p class="mb-2">
                            El <b>SIRADIG F.572 Web</b> es el formulario obligatorio donde cada empleado declara sus deducciones personales (cónyuge, hijos, cuotas de prepaga, alquiler de casa habitación, servicio doméstico, seguros, etc.) para la liquidación de Ganancias 4ta Categoría (RG 4003).
                        </p>
                        <hr class="my-2"/>
                        <ol class="mb-1 ps-3">
                            <li>Ingrese a la web de <b>AFIP / ARCA</b> con Clave Fiscal de la empresa.</li>
                            <li>Abra el servicio <b>"SIRADIG - Empleador"</b>.</li>
                            <li>En la solapa de consultas/descargas, elija el año fiscal y descargue las presentaciones. AFIP le entregará un archivo <b>.ZIP</b> (con todas las declaraciones de la nómina) o un <b>.XML</b> individual.</li>
                            <li>Seleccione ese archivo descargado en el campo inferior y presione <b>Procesar e Importar</b>.</li>
                        </ol>
                        <p class="mb-0 text-muted small">
                            ⚡ <i>El sistema emparejará automáticamente cada declaración por el CUIL del trabajador y actualizará sus deducciones para la liquidación de sueldos.</i>
                        </p>
                    </div>

                    <div class="alert alert-success" role="status" invisible="state != 'done'">
                        <h5 class="alert-heading font-weight-bold">✅ Proceso de Importación Finalizado</h5>
                        <p class="mb-0">
                            Revise el detalle de empleados procesados y deducciones actualizadas en el recuadro inferior.
                        </p>
                    </div>

                    <group invisible="state != 'choose'">
                        <group string="Archivo a Importar">
                            <field name="file_data" filename="file_name"/>
                            <field name="file_name" invisible="1"/>
                        </group>
                        <group string="Configuración del Cálculo">
                            <field name="periodo_fiscal"/>
                            <field name="auto_apply"/>
                        </group>
                    </group>

                    <group invisible="state != 'done'">
                        <field name="result_summary" widget="text" nolabel="1" style="font-family: monospace; background-color: #f8f9fa; padding: 12px; border-radius: 4px; border: 1px solid #dee2e6; max-height: 400px; overflow-y: auto;"/>
                    </group>
                </sheet>
                <footer>
                    <button
                        name="action_import_siradig"
                        type="object"
                        string="📥 Procesar e Importar F.572"
                        class="btn-primary"
                        invisible="state != 'choose'"
                    />
                    <button special="cancel" string="Cancelar" class="btn-secondary" invisible="state != 'choose'"/>
                    <button special="cancel" string="Cerrar" class="btn-primary" invisible="state != 'done'"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_hr_siradig_import_wizard" model="ir.actions.act_window">
        <field name="name">Importar SIRADIG AFIP (F.572)</field>
        <field name="res_model">hr.siradig.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
