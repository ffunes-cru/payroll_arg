<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_payslip_run_input_import_form" model="ir.ui.view">
        <field name="name">hr.payslip.run.input.import.form</field>
        <field name="model">hr.payslip.run.input.import</field>
        <field name="arch" type="xml">
            <form string="Importar Novedades (CSV)">
                <p class="text-muted">
                    Una fila por empleado. Identifique al empleado con una columna
                    <code>legajo</code>, <code>cuil</code> o <code>nombre</code>; el resto de las
                    columnas deben llamarse como el código de la novedad
                    (<code>HS_NORM</code>, <code>HS_EXT50</code>, <code>PRESENTISMO</code>,
                    <code>CANT_VIANDAS</code>, ...). Separador <code>;</code> o <code>,</code>.
                </p>
                <group>
                    <field name="payslip_run_id" invisible="1"/>
                    <field name="csv_file" filename="csv_filename"/>
                    <field name="csv_filename" invisible="1"/>
                </group>
                <footer>
                    <button name="action_import" type="object" string="Importar" class="btn-primary"/>
                    <button special="cancel" string="Cancelar" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
