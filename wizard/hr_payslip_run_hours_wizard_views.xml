<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_payslip_run_hours_wizard_form" model="ir.ui.view">
        <field name="name">hr.payslip.run.hours.wizard.form</field>
        <field name="model">hr.payslip.run.hours.wizard</field>
        <field name="arch" type="xml">
            <form string="Carga Masiva de Horas (Jornales Quincenales)">
                <sheet>
                    <div class="alert alert-info" role="alert">
                        <strong>Carga de Novedades y Override de Horas:</strong> Las <b>Hs Calendario</b> reflejan las horas teóricas del período. Puede ingresar o modificar las <b>Hs Normales</b> y las <b>Hs Extras (50% y 100%)</b> manualmente para cada operario. Al presionar <b>Guardar y Recalcular</b>, se aplicará el override en el recibo y se recalcularán los haberes y netos.
                    </div>
                    <group>
                        <group string="Importación Opcional desde CSV">
                            <field name="csv_file" filename="csv_filename"/>
                            <field name="csv_filename" invisible="1"/>
                            <button
                                name="action_import_csv"
                                type="object"
                                string="Procesar y Aplicar CSV a la Tabla"
                                class="btn btn-outline-secondary"
                                invisible="not csv_file"
                            />
                        </group>
                    </group>
                    <group string="Carga Rápida de Horas Quincenales">
                        <group>
                            <label for="global_hs_norm" string="Hs Normales para Todos"/>
                            <div class="o_row">
                                <field name="global_hs_norm" class="oe_inline" style="max-width: 100px; font-weight: bold; font-size: 1.1em;"/>
                                <button
                                    name="action_apply_global_hours"
                                    type="object"
                                    string="⚡ Aplicar a Todos"
                                    class="btn btn-primary btn-sm ms-2"
                                    help="Establece este número de horas normales para todos los operarios en la tabla inferior."
                                />
                            </div>
                        </group>
                        <group>
                            <div class="btn-group">
                                <button
                                    name="action_populate_from_calendars"
                                    type="object"
                                    string="📅 Cargar según Calendario (2 Semanas)"
                                    class="btn btn-outline-secondary btn-sm me-2"
                                    help="Rellena las horas teóricas de 2 semanas del horario asignado a cada contrato (ej: 88hs para 44h/sem)."
                                />
                                <button
                                    name="action_populate_from_attendance"
                                    type="object"
                                    string="⏱️ Cargar desde Fichero / Asistencias"
                                    class="btn btn-outline-success btn-sm"
                                    help="Lee las fichadas reales de cada operario en el módulo de Asistencias para la quincena."
                                />
                            </div>
                        </group>
                    </group>
                    <field name="line_ids">
                        <list editable="bottom" create="0" delete="0">
                            <field name="payslip_id" column_invisible="1" force_save="1"/>
                            <field name="employee_id" readonly="1" force_save="1"/>
                            <field name="legajo" readonly="1" force_save="1"/>
                            <field name="hourly_wage" readonly="1" widget="monetary" force_save="1"/>
                            <field name="hours_theoretical" string="Hs Calendario" readonly="1" force_save="1"/>
                            <field name="hs_norm" string="Hs Normales (Override)" style="font-weight: bold; color: #0056b3;"/>
                            <field name="hs_ext50" string="Hs Extras 50% (Override)"/>
                            <field name="hs_ext100" string="Hs Extras 100% (Override)"/>
                            <field name="vac_dias" string="Días Vacaciones"/>
                        </list>
                    </field>
                </sheet>
                <footer>
                    <button
                        name="action_apply_and_recompute"
                        string="Guardar y Recalcular Recibos"
                        type="object"
                        class="btn-primary"
                    />
                    <button special="cancel" string="Cancelar" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
